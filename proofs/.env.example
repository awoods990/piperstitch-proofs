# PiperStitch Proofs — copy to .env for local development.
DATABASE_PATH=./proofs.db
ARTIFACT_DIR=./artifacts
PUBLIC_BASE_URL=http://127.0.0.1:8100
SESSION_SECRET=change-me-to-32-plus-random-characters
# Identity + saved projects (PiperStitch License Admin). Leave blank locally:
# any email then signs in with a Proofs-issued code and becomes an owner.
LICENSE_ADMIN_URL=
WEB_API_KEY=
# The PiperStitch app server (stitch engine). Locally: `swift run` in Core's
# server/ with accounts off; in production the key-guarded internal routes.
CORE_SERVER_URL=http://127.0.0.1:8089
CORE_API_KEY=
# Email: write to a folder locally, SMTP (Microsoft 365) or Postmark in production.
EMAIL_OUTBOX_DIR=./outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PiperStitch Proofs <proofs@piperstitch.com>
POSTMARK_API_TOKEN=
# Texting (Twilio). TWILIO_FROM is a number (+1...) or a Messaging Service SID (MG...).
# US delivery needs A2P 10DLC registration on the Twilio side. SMS_OUTBOX_DIR writes texts to a folder for dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_OUTBOX_DIR=./sms-outbox
# Billing: the Proofs add-on price in the same Stripe account as License Admin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROOFS=
PROOFS_PRICE_CENTS=2500
# Optional Ed25519 private key (base64url, 32 bytes) to sign certificates.
CERTIFICATE_SIGNING_KEY=
# Shared secret for provider webhooks (Postmark bounces / inbound): the URL carries ?token=...
WEBHOOK_TOKEN=
